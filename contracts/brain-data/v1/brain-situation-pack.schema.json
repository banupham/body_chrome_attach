{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://body.local/contracts/brain-data/v1/brain-situation-pack.schema.json",
  "title": "BrainSituationPack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["packVersion", "packId", "goal", "situation", "capabilities", "strategies", "experiences", "expectedEffects", "policy", "environment", "sourceRecordIds", "createdAt"],
  "properties": {
    "packVersion": {"const": "1.0"},
    "packId": {"type": "string", "minLength": 1},
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "parameters"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "parameters": {"type": "object", "additionalProperties": true},
        "directiveId": {"type": "string"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "companyId": {"type": "string"},
        "deviceId": {"type": "string"},
        "browserInstanceId": {"type": "string"},
        "taskId": {"type": "string"},
        "workspaceId": {"type": "string"}
      }
    },
    "situation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["humanActive"]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "autonomy", "confidence", "evidenceRecordIds"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "autonomy": {"type": "integer", "minimum": 0, "maximum": 4},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidenceRecordIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "strategies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capability", "steps", "evidenceRecordIds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "steps": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "humanPreference": {"type": "number", "minimum": 0, "maximum": 1},
          "successRate": {"type": "number", "minimum": 0, "maximum": 1},
          "evidenceRecordIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recordId", "relevance"],
        "properties": {
          "recordId": {"type": "string", "minLength": 1},
          "relevance": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "expectedEffects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "effectType", "expected", "evidenceRecordIds"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "effectType": {"type": "string", "minLength": 1},
          "expected": {"type": "object", "additionalProperties": true},
          "evidenceRecordIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "eligible", "allowedActions", "blockedActions"],
      "properties": {
        "class": {"enum": ["SAFE_AUTO", "HUMAN_APPROVED", "RESTRICTED"]},
        "eligible": {"type": "boolean"},
        "allowedActions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blockedActions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "reason": {"type": "string"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "browserState"],
      "properties": {
        "eligible": {"type": "boolean"},
        "browserState": {"enum": ["REGISTERED", "OFFLINE", "ENV_CHECK", "ACTIVE", "BUSY", "HUMAN_CONTROL", "QUARANTINED", "ERROR"]},
        "healthRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "sourceRecordIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "createdAt": {"type": "string", "format": "date-time"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "body-observation.schema.json",
  "title": "BodyObservation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "observedAt",
    "scope",
    "bodyState",
    "browserUi",
    "control",
    "content",
    "freshness"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0"
    },
    "observedAt": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browserInstanceId",
        "tabId"
      ],
      "properties": {
        "browserInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "extensionInstanceId": {
          "type": [
            "string",
            "null"
          ]
        },
        "tabId": {
          "type": "integer"
        },
        "siteKey": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "windowId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "navigationToken": {
          "type": [
            "string",
            "null"
          ]
        },
        "navigationEpoch": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bodyState": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "pointer",
        "online",
        "activeTabId"
      ],
      "properties": {
        "pointer": {
          "type": "object"
        },
        "online": {
          "type": "boolean"
        },
        "activeTabId": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "activeTarget",
        "lastObservedTarget",
        "semanticControls"
      ],
      "properties": {
        "activeTarget": {
          "type": [
            "object",
            "null"
          ]
        },
        "lastObservedTarget": {
          "type": [
            "object",
            "null"
          ]
        },
        "semanticControls": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "tabContext",
        "page",
        "semantic"
      ],
      "properties": {
        "tabContext": {
          "type": [
            "object",
            "null"
          ]
        },
        "page": {
          "type": [
            "object",
            "null"
          ]
        },
        "semantic": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveRefreshAttempted",
        "liveRefreshSucceeded",
        "browserUiAgeMs",
        "tabContextAgeMs",
        "pageAgeMs",
        "semanticAgeMs",
        "controlAgeMs"
      ],
      "properties": {
        "liveRefreshAttempted": {
          "type": "boolean"
        },
        "liveRefreshSucceeded": {
          "type": "boolean"
        },
        "tabContextAgeMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "pageAgeMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "semanticAgeMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "controlAgeMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "browserUiAgeMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "browserUi": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "available",
        "observed",
        "reason",
        "confidence",
        "source",
        "observedAt",
        "scope",
        "window",
        "focusedControl",
        "addressBar",
        "tabs",
        "controls",
        "signature"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "observed": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "observedAt": {
          "type": "integer",
          "minimum": 0
        },
        "scope": {
          "type": "object"
        },
        "window": {
          "type": [
            "object",
            "null"
          ]
        },
        "focusedControl": {
          "type": [
            "object",
            "null"
          ]
        },
        "addressBar": {
          "type": [
            "object",
            "null"
          ]
        },
        "tabs": {
          "type": "array"
        },
        "controls": {
          "type": "array"
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

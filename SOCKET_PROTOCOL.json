{
  "controlProtocolVersion": 7,
  "extensionProtocolCompatibility": [5, 6],
  "url": "ws://127.0.0.1:8765",
  "transportRole": "internal Company Runtime transport; not the product's primary command port",
  "roles": ["extension", "brain", "debug_client"],
  "identity": {
    "local": ["companyId", "deviceId"],
    "browser": ["browserInstanceId", "extensionInstanceId", "runtimeExtensionId"],
    "applicationModel": "one Company Runtime application per Device by default",
    "legacyV5BrowserFallback": "browser-<extensionInstanceId> when an older v5 adapter has no browserInstanceId"
  },
  "authentication": {
    "brain": "256-bit local token from daemon/profiles/.auth/brain.token",
    "debugClient": "256-bit local token from daemon/profiles/.auth/client.token or BODY_DEBUG_TOKEN",
    "extension": "TOFU pairing bound to extensionInstanceId + runtimeExtensionId + browserInstanceId when supplied"
  },
  "controllerPolicy": {
    "brain": "exclusive controller; physical execution requires an existing executable taskId",
    "debugClient": "diagnostic/test only; mutating commands rejected while Brain is attached",
    "daemonConsole": "diagnostic/test only",
    "bodyRuntime": "continues recording and learning with or without Brain"
  },
  "brain": {
    "hello": {"type": "HELLO", "role": "brain", "protocolVersion": 7, "controllerId": "brain-instance", "token": "required"},
    "queries": ["BODY_STATUS", "EXTENSIONS_LIST", "BROWSERS_LIST", "TABS_LIST", "TASKS_LIST", "TASK_GET", "ENVIRONMENT_STATUS"],
    "managerActions": ["TASK_CREATE", "TASK_APPROVE", "TASK_START", "TASK_COMPLETE", "TASK_FAIL", "TASK_CANCEL", "ENVIRONMENT_PROBE", "ENVIRONMENT_PROBE_ALL"],
    "physicalActions": ["INTENT_EXECUTE", "STRATEGY_EXECUTE", "TAB_SWITCH", "BROWSER_COMMAND"],
    "physicalActionRequirement": "taskId is required; TaskManager resolves browserInstanceId/extension/tab ownership and Browser must be Environment-eligible before BODY execution",
    "events": ["BODY_EVENT"],
    "freeformCommandStrings": false
  },
  "environmentGuardian": {
    "scope": "Browser Instance, never individual Tabs",
    "defaultPolicy": {
      "directOnly": true,
      "requireUniquePublicIpAcrossOnlineBrowsers": true,
      "requireUniqueEnvironmentSignatureAcrossOnlineBrowsers": true,
      "strictSameBrowserEnvironmentConsistency": false
    },
    "browserFlow": "OFFLINE -> ENV_CHECK -> ACTIVE or QUARANTINED",
    "signals": ["browser environment signature hash", "public egress IP", "Chrome proxy mode", "device proxy environment", "Windows system proxy", "VPN/tunnel interface heuristic", "extension/CDP availability"],
    "readOnly": true,
    "forbidden": ["fingerprint spoofing", "proxy/VPN concealment", "IP rotation for evasion", "proxy mutation", "DNS/route mutation", "detector evasion"],
    "extensionRequest": "ENVIRONMENT_PROBE",
    "publicIpEndpoint": "BODY_PUBLIC_IP_ENDPOINT; HTTPS required; default https://api.ipify.org?format=json"
  },
  "taskPolicy": {
    "classes": ["SAFE_AUTO", "HUMAN_APPROVED", "RESTRICTED"],
    "safeAuto": ["discovery", "open/navigation", "review/classification", "collect metadata", "internal analysis"],
    "restricted": ["spam", "fake engagement", "metric manipulation", "detector evasion", "fingerprint manipulation", "proxy/VPN concealment"]
  },
  "taskWorkspace": {
    "identity": ["taskId", "browserInstanceId", "primaryTabId", "tabIds"],
    "invariant": "one tab belongs to at most one active TaskWorkspace; one Browser may host many Tasks on different tabs"
  },
  "debugClient": {
    "hello": {"type": "HELLO", "role": "debug_client", "protocolVersion": 7, "token": "required"},
    "command": {"type": "COMMAND", "requestId": "id", "command": "status"},
    "purpose": "manual smoke testing and diagnostics only"
  },
  "pageMotor": {"capability": "HUMAN_MOTOR", "planner": "src/canonical_motor_planner.js", "allowedCdpMethods": ["Input.dispatchMouseEvent", "Input.dispatchKeyEvent"]},
  "browserUi": {"capability": "BROWSER_UI", "executionBackend": "persistent Windows SendInput worker", "resultTruth": "delivered, observed effect, verified and taskSuccess are separate concepts"},
  "extension": {
    "hello": {"type": "HELLO", "role": "extension", "protocolVersion": "5 or 6", "browserInstanceId": "persistent logical Chrome identity", "extensionId": "persistent extensionInstanceId", "token": "paired token or null on first pairing"},
    "authEvents": ["AUTH_PAIRED", "AUTH_ERROR"],
    "requests": ["PING", "LIST_TABS", "ACTIVE_TAB", "ENVIRONMENT_PROBE", "BODY_EXECUTE", "BODY_DETACH", "TAB_SWITCH", "FOCUS_WINDOW", "BROWSER_UI_END", "RECORD_SET", "CURSOR_SET"],
    "events": ["RECORDER_EVENT", "TAB_EVENT", "TAB_CONTEXT", "TAB_REMOVED", "KEEPALIVE"]
  },
  "trainingGroundTruth": "human-only",
  "executionCapabilities": ["HUMAN_MOTOR", "BROWSER_UI"]
}
